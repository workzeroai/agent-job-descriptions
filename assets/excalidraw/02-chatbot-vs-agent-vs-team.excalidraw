    {
      "id": "02-chatbot-vs-agent-vs-team_txt_10",
      "type": "text",
      "x": 92,
      "y": 441,
      "width": 912,
      "height": 216,
      "angle": 0,
      "strokeColor": "#1E1E1E",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
